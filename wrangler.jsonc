{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "searchscope-ai-visibility-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Rate limits for the public /mcp endpoint, applied in src/index.ts on every
  // hostname (custom domain and workers.dev). Counted per Cloudflare location,
  // not worldwide, and approximate. All four are required: /mcp returns 503
  // if any is missing. namespace_id values are account-wide; a value shared
  // with another Worker would share its counters.
  "ratelimits": [
    { "name": "MCP_RATE_LIMIT_PER_IP", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_RATE_LIMIT_GLOBAL", "namespace_id": "4102", "simple": { "limit": 1200, "period": 60 } },
    // tools/call only (each one crawls up to 15 pages), keyed by client IP.
    { "name": "MCP_RATE_LIMIT_TOOL_CALLS_PER_IP", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } },
    // tools/call only, keyed by the audited hostname (www. stripped), so many
    // clients together cannot turn the Worker on one website.
    { "name": "MCP_RATE_LIMIT_PER_TARGET", "namespace_id": "4104", "simple": { "limit": 10, "period": 60 } }
  ],
  // Branch and pull-request Previews (`wrangler preview`, run by Workers Builds)
  // need their own bindings. Separate namespace IDs keep preview traffic out of
  // the production counters. /mcp answers 403 on preview hostnames anyway (see
  // SERVICE_HOSTNAMES), so these only have to exist for the build to succeed.
  "previews": {
    "ratelimits": [
      { "name": "MCP_RATE_LIMIT_PER_IP", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
      { "name": "MCP_RATE_LIMIT_GLOBAL", "namespace_id": "4202", "simple": { "limit": 1200, "period": 60 } },
      { "name": "MCP_RATE_LIMIT_TOOL_CALLS_PER_IP", "namespace_id": "4203", "simple": { "limit": 20, "period": 60 } },
      { "name": "MCP_RATE_LIMIT_PER_TARGET", "namespace_id": "4204", "simple": { "limit": 10, "period": 60 } }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2
  }
  // No storage bindings (no KV, D1 or Durable Objects): the server is fully stateless.
  // Deploy with `npm run deploy` (needs a Cloudflare API token) or connect the
  // repository to Cloudflare Workers Builds for automatic deploys from `main`.
}
